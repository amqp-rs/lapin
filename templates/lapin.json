            "name": "destination",
            "type": "ShortString",
            "clone": true
          },
          {
            "name": "source",
            "type": "ShortString",
            "clone": true
          },
          {
            "name": "routing_key",
            "type": "ShortString",
            "clone": true
          },
          {
            "name": "creation_arguments",
            "type": "FieldTable"
          }
        ],
        "nowait_hook": true
      }
    },
    "bind-ok": {
      "metadata": {
        "received_hook": {
          "params": ["destination", "source", "routing_key", "creation_arguments"]
        }
      }
