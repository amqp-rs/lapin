        ],
        "state": [
          {
            "name": "destination",
            "type": "ShortString",
            "clone": true
          },
          {
            "name": "source",
            "type": "ShortString",
            "clone": true
          },
          {
            "name": "routing_key",
            "type": "ShortString",
            "clone": true
