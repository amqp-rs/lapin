    "declare": {
      "metadata": {
        "require_wrapper": true,
        "extra_args": [
          {
            "name": "exchange_kind",
            "type": "ExchangeKind"
          }
        ],
        "confirmation": {
          "type": "()"
        },
        "init_clones": [
          {
            "from": "arguments",
            "to": "creation_arguments"
          }
        ],
        "state": [
          {
            "name": "exchange",
            "type": "ShortString",
            "clone": true
          },
          {
            "name": "exchange_kind",
            "type": "ExchangeKind"
          },
          {
            "name": "options",
            "type": "ExchangeDeclareOptions"
          },
          {
            "name": "creation_arguments",
